// This is your StartUprisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Users {
  id   String   @id @default(uuid())
  type TypeUser

  avatar String

  email String @unique
  senha String

  nome            String
  telefone        String
  data_nascimento String

  tempo_experiencia  String?
  tipos_investimento String?
  fontes_renda       String?
  renda_anual        String?

  localizacao String?
  instagram   String?
  facebook    String?
  linkedin    String?
  website     String?

  biografia String?

  Administrador Boolean @default(false)

  token_recover_password String?  @unique
  date_update            DateTime @updatedAt
  date_create            DateTime @default(now())

  companies         Companies[]
  releases          Releases[]
  group             Group[]
  Valuation         Valuation[]
  documents         Document[]
  business_proposal BusinessProposal[]
  negotiantion      Negotiation[]
  notifications     Notifications[]

  @@map("usuarios")
}

enum TypeUser {
  INVESTIDOR
  EMPREENDEDOR
}

model Companies {
  id        String  @id @default(uuid())
  logotipo  String
  nome      String
  email     String
  setor     String
  endereco  String
  cnpj      String
  contato   String
  biografia String?
  instagram String?
  facebook  String?
  linkedin  String?
  youtube   String?
  x         String?
  site      String?

  patrimonio           Int?
  reserva_financeira   Int?
  acordo_operacional   Boolean?
  estrutura_governanca Boolean?
  projecao_crescimento String?
  projecao_futura      String?
  competidores         String?

  dono   Users  @relation(fields: [donoId], references: [id])
  donoId String

  date_update DateTime @updatedAt
  date_create DateTime @default(now())

  Group            Group[]
  Releases         Releases[]
  Partner          Partner[]
  Collaborator     Collaborator[]
  Valuation        Valuation[]
  Document         Document[]
  BusinessProposal BusinessProposal[]
  Negotiation      Negotiation[]

  @@map("empresas")
}

model Group {
  id String @id @default(uuid())

  status Status

  company   Companies @relation(fields: [companyId], references: [id])
  companyId String

  member   Users  @relation(fields: [memberId], references: [id])
  memberId String

  viewedNotification Boolean

  authorId String

  date_update DateTime @updatedAt
  date_create DateTime @default(now())

  @@map("grupo")
}

enum Status {
  PENDENTE
  APROVADO
  NEGADO
}

model Releases {
  id String @id @default(uuid())

  month          Int
  year           Int
  valuation      Float?
  lucroLiquido   Float
  receitaLiquida Float
  despesaBruta   Float

  docs String?

  company   Companies @relation(fields: [companyId], references: [id])
  companyId String

  author   Users  @relation(fields: [authorId], references: [id])
  authorId String

  date_update DateTime @updatedAt
  date_create DateTime @default(now())

  @@map("lancamentos")
}

model Department {
  id String @id @default(uuid())

  @@map("departamentos")
}

model Partner {
  id String @id @default(uuid())

  people   People @relation(fields: [peopleId], references: [id])
  peopleId String

  company   Companies @relation(fields: [companyId], references: [id])
  companyId String

  date_update DateTime @updatedAt
  date_create DateTime @default(now())

  @@map("socios")
}

model Collaborator {
  id String @id @default(uuid())

  people   People @relation(fields: [peopleId], references: [id])
  peopleId String

  company   Companies @relation(fields: [companyId], references: [id])
  companyId String

  date_update DateTime @updatedAt
  date_create DateTime @default(now())

  @@map("colaboradores")
}

model People {
  id          String @id @default(uuid())
  avatar      String
  name        String
  office      String
  description String
  email       String @unique
  contact     String

  partner      Partner[]
  collaborator Collaborator[]

  date_update DateTime @updatedAt
  date_create DateTime @default(now())

  @@map("pessoa")
}

model Expenses {
  id String @id @default(uuid())

  @@map("despesas")
}

model StartUp {
  id               String @id @default(uuid())
  companyName      String
  describe         String @db.Text
  sizeCompany      String
  presentationLink String
  usefulLink       String
  city             String
  phone            String

  date_update DateTime @updatedAt
  date_create DateTime @default(now())

  @@map("startup")
}

model Valuation {
  id String @id @default(uuid())

  value Float
  docs  String

  company   Companies @relation(fields: [companyId], references: [id])
  companyId String

  author   Users  @relation(fields: [authorId], references: [id])
  authorId String

  date_update DateTime @updatedAt
  date_create DateTime @default(now())

  @@map("valuation")
}

model Document {
  id String @id @default(uuid())

  title String
  uri   String

  company   Companies @relation(fields: [companyId], references: [id])
  companyId String

  author   Users  @relation(fields: [authorId], references: [id])
  authorId String

  date_update DateTime @updatedAt
  date_create DateTime @default(now())

  @@map("documentos")
}

enum StatusBusiness {
  PENDENTE
  APROVADO
  RECUSADO
  CONTRAPROPOSTA
}

model BusinessProposal {
  id String @id @default(uuid())

  status StatusBusiness

  user     Users  @relation(fields: [authorId], references: [id])
  authorId String

  proposed_investment      Float
  financial_participation  Float
  investment_purpose       String
  investment_return_period String
  message                  String @db.Text

  company   Companies @relation(fields: [companyId], references: [id])
  companyId String

  negotiantion Negotiation[]

  date_update DateTime @updatedAt
  date_create DateTime @default(now())

  @@map("propostas_de_negocio")
}

model Negotiation {
  id String @id @default(uuid())

  report StatusBusiness

  bunsiness_proposal BusinessProposal @relation(fields: [businessId], references: [id])
  businessId         String

  user     Users  @relation(fields: [authorId], references: [id])
  authorId String

  proposed_investment      Float?
  financial_participation  Float?
  investment_purpose       String? @db.Text
  investment_return_period String?
  message                  String? @db.Text

  company   Companies @relation(fields: [companyId], references: [id])
  companyId String

  date_update DateTime @updatedAt
  date_create DateTime @default(now())

  @@map("negociacoes")
}

model Notifications {
  id String @id @default(uuid())

  user   Users  @relation(fields: [userId], references: [id])
  userId String

  viewed Boolean

  message String @db.Text

  link String?

  date_update DateTime @updatedAt
  date_create DateTime @default(now())

  @@map("notificacoes")
}

model Leads {
  id String @id @default(uuid())

  company   String
  email     String
  valuation Float
  type      String
  date      String

  name_of_person_responsible     String?
  whatsapp_of_person_responsible String?
  foundation_date                String?
  site                           String?
  segmento                       String?
  business_model                 String?
  locality                       String?
  investment_stage               String?

  operational_stage String?
  arr               Float?
  mrr               Float?
  ntm               Float?
  profit_margin     Float?
  burnrate          Float?
  breakeven         String?
  runrate           String?

  projected_revenue_for_the_year Float?
  projected_ebitda               Float?
  immobilized                    Float?
  current_annual_investment      Float?
  annual_investment_next_5_years Float?
  cash_and_stock_value           Float?
  debt                           Float?

  date_update DateTime @updatedAt
  date_create DateTime @default(now())

  @@map("leads")
}

model ExternalUsers {
  id String @id @default(uuid())

  username String
  password String

  date_update DateTime @updatedAt
  date_create DateTime @default(now())

  @@map("usuarios_externos")
}
