// This is your StartUprisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum TypeUser {
  INVESTIDOR
  EMPREENDEDOR
  ADMINISTRADOR
}

enum investorStatus {
  APROVADO
  RECUSADO
  PENDENTE
  LIXEIRA
}

model Users {
  id     String          @id @default(uuid())
  type   TypeUser
  status investorStatus? @default(PENDENTE)

  avatar String

  email String @unique
  senha String

  nome            String
  telefone        String
  data_nascimento String

  tempo_experiencia  String?
  tipos_investimento String?
  fontes_renda       String?
  renda_anual        String?

  localizacao String?
  instagram   String?
  facebook    String?
  linkedin    String?
  website     String?

  biografia String?

  token_recover_password String?  @unique
  date_update            DateTime @updatedAt
  date_create            DateTime @default(now())

  companies Companies[]

  authorId  String?
  Proposta  Proposta[]
  Mensagens Mensagens[]

  @@map("usuarios")
}

enum StatusCompany {
  ANALISE
  APROVADO
  RECUSADO
  LIXEIRA
}

model Companies {
  id        String        @id @default(uuid())
  logotipo  String
  status    StatusCompany @default(ANALISE)
  nome      String
  email     String
  setor     String
  endereco  String
  cnpj      String
  contato   String
  biografia String?
  instagram String?
  facebook  String?
  linkedin  String?
  youtube   String?
  x         String?
  site      String?

  patrimonio           String
  reserva_financeira   String
  acordo_operacional   String
  estrutura_governanca String
  projecao_crescimento String
  projecao_futura      String
  competidores         String

  imposto             String?
  YTD                 String?
  despesas            String?
  dividas             String?
  receitas            String?
  contratos_firmados  String?
  contratos_pendentes String?

  dono   Users  @relation(fields: [donoId], references: [id])
  donoId String

  date_update DateTime   @updatedAt
  date_create DateTime   @default(now())
  Proposta    Proposta[]

  @@map("empresas")
}

enum StatusProposta {
  PENDENTE
  ACEITA
  RECUSADA
  CONTRAPROPOSTA
}

model Proposta {
  id String @id @default(uuid())

  status StatusProposta @default(PENDENTE)

  titulo                 String
  descricao              String
  valor_investimento     String
  participacao_acionaria String

  autorId String
  autor   Users  @relation(fields: [autorId], references: [id])

  companyId String
  company   Companies @relation(fields: [companyId], references: [id])

  Negociacao Negociacao[]

  date_create DateTime @default(now()) @map("data_criacao")
  date_update DateTime @updatedAt @map("data_atualizacao")

  @@map("proposta_investimento")
}

model Negociacao {
  id String @id @default(uuid())

  propostaId String
  proposta   Proposta @relation(fields: [propostaId], references: [id])

  date_create DateTime    @default(now()) @map("data_criacao")
  date_update DateTime    @updatedAt @map("data_atualizacao")
  Mensagens   Mensagens[]

  @@map("negociacao_para_proposta")
}

model Mensagens {
  id String @id @default(uuid())

  autorId String
  autor   Users  @relation(fields: [autorId], references: [id])

  negociacaoId String
  negociacao   Negociacao @relation(fields: [negociacaoId], references: [id])

  date_create DateTime @default(now()) @map("data_criacao")
  date_update DateTime @updatedAt @map("data_atualizacao")

  @@map("mensagens_negociacao")
}
